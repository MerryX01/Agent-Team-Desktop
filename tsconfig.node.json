{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@storage/*": ["packages/storage/src/*"],
      "@adapters/*": ["packages/adapters/src/*"],
      "@orchestrator/*": ["packages/orchestrator/src/*"]
    }
  },
  "include": ["electron/main/**/*.ts", "electron/preload/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "electron.vite.config.ts"]
}
