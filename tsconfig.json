{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@storage/*": ["packages/storage/src/*"],
      "@adapters/*": ["packages/adapters/src/*"],
      "@orchestrator/*": ["packages/orchestrator/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "packages/**/*.ts", "electron/preload/**/*.ts"]
}
